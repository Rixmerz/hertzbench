+/*
+ * Change the core clock without disturbing CCOUNT.
+ *
+ * CCOUNT is computed as ccount_base + ticks(now - time_base) at the clock's
+ * current period, so changing the period alone rescales all the time since
+ * time_base: CCOUNT jumps by (elapsed * delta_f), backwards when the clock
+ * slows down, and CCOMPARE timers stay armed for the old frequency. ESP-IDF
+ * switches 160 MHz -> XTAL -> 240 MHz while the FreeRTOS tick runs (Arduino's
+ * setCpuFrequencyMhz); a tick taken in the XTAL window armed the next one
+ * seconds away, the core stopped ticking and the interrupt watchdog reset the
+ * chip. On silicon CCOUNT only changes rate, so fold the count at the old
+ * period first, then re-arm the pending comparators at the new one.
+ *
+ * Callers hold the BQL; under MTTCG this writes the other vCPU's timebase from
+ * this thread, which a CCOUNT read racing the switch can see half-updated.
+ * Clock switches are a handful per boot.
+ */
+void xtensa_cpu_set_clock_hz(XtensaCPU *cpu, unsigned hz)
+{
+    CPUXtensaState *env = &cpu->env;
+    unsigned i;
+
+    if (clock_get(cpu->clock) == CLOCK_PERIOD_FROM_HZ(hz)) {
+        return;
+    }
+    HELPER(update_ccount)(env);
+    env->ccount_base = env->sregs[CCOUNT];
+    env->time_base = env->ccount_time;
+    clock_update_hz(cpu->clock, hz);
+
+    /*
+     * Not HELPER(update_ccompare): it would also drop a tick already raised.
+     * A timer that is due (deadline passed, or CCOUNT already at CCOMPARE)
+     * but has not run yet is left to fire: re-arming it would push the tick
+     * a whole 2^32-cycle wrap away.
+     */
+    for (i = 0; i < env->config->nccompare; ++i) {
+        QEMUTimer *t = env->ccompare[i].timer;
+        uint32_t dcc = env->sregs[CCOMPARE + i] - env->sregs[CCOUNT];
+
+        if (timer_pending(t) && !timer_expired(t, env->ccount_time) && dcc) {
+            timer_mod(t, env->ccount_time + clock_ticks_to_ns(cpu->clock, dcc));
+        }
+    }
+}
